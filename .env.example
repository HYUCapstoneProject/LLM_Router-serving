LLM_ROUTER_INTERNAL_API_TOKEN=replace-with-secret

LLM_ROUTER_EMBED_MODEL_ID=BAAI/bge-large-en-v1.5
LLM_ROUTER_EMBED_MODEL_REVISION=d4aa6901d3a41ba39fb536a557fa166f842b0e09
LLM_ROUTER_EMBED_MODEL_VERSION=bge-large-en-v1.5
LLM_ROUTER_EMBED_EXPECTED_DIM=1024
LLM_ROUTER_EMBED_LOCAL_FILES_ONLY=false

# Router model source. Set exactly one: a local directory for development, or the
# approved GCS package URI for deployment. Deployment updates these two values
# together and restarts the process to serve a new model.
LLM_ROUTER_ROUTER_MODEL_PATH=
LLM_ROUTER_ROUTER_MODEL_PACKAGE_URI=gs://llm-router-mlserver/models/router-modernbert/router-modernbert-base-routerbench-20260731-21c2f1b/approved
LLM_ROUTER_ROUTER_MODEL_VERSION=router-modernbert-base-routerbench-20260731-21c2f1b
LLM_ROUTER_ROUTER_MODEL_CACHE_DIR=var/models
LLM_ROUTER_ROUTER_MODEL_REQUIRE_APPROVED=true
LLM_ROUTER_MODEL_CODE_COMMIT=45dcc6d
LLM_ROUTER_ROUTER_MAX_LENGTH=8192
LLM_ROUTER_MODEL_DEVICE=auto

LLM_ROUTER_RETRAINING_DB_PATH=var/retraining.sqlite3
LLM_ROUTER_ALLOWED_GCS_BUCKETS=llm-router-mlserver
LLM_ROUTER_SUPPORTED_FEEDBACK_SCHEMAS=feedback-export-v0.1
LLM_ROUTER_RETRAINING_STALE_SUBMISSION_SECONDS=900

LLM_ROUTER_VERTEX_PROJECT=project-763753da-fa8f-4afd-b31
LLM_ROUTER_VERTEX_LOCATION=us-west1
LLM_ROUTER_VERTEX_PIPELINE_TEMPLATE_URI=gs://llm-router-mlserver/pipelines/v2-20260815/feedback-retraining-pipeline.yaml
LLM_ROUTER_VERTEX_PIPELINE_ROOT=gs://llm-router-mlserver/pipeline-root
LLM_ROUTER_VERTEX_PIPELINE_SERVICE_ACCOUNT=vertex-pipeline-sa@project-763753da-fa8f-4afd-b31.iam.gserviceaccount.com
LLM_ROUTER_VERTEX_PIPELINE_NETWORK=
LLM_ROUTER_VERTEX_TRAINING_SERVICE_ACCOUNT=vertex-training-sa@project-763753da-fa8f-4afd-b31.iam.gserviceaccount.com
LLM_ROUTER_VERTEX_TRAINING_OUTPUT_DIRECTORY=gs://llm-router-mlserver/vertex-training-output
LLM_ROUTER_MODEL_PUBLISH_ROOT_URI=gs://llm-router-mlserver/models/router-modernbert

# These are sent as Vertex pipeline parameters and therefore OVERRIDE the defaults
# compiled into the IR. They must stay on the v2 labeling/training contract
# (minimum-sufficient-tier-v2 + routerbench-training-preprocess-v2-balanced);
# pointing them at a v1 config silently retrains the router on the old contract.
LLM_ROUTER_BASE_TRAINING_DATASET_URI=gs://llm-router-mlserver/datasets/routerbench/withmartian-routerbench-2024-03-27__minimum-sufficient-tier-v2__routerbench-training-preprocess-v2-balanced/training.parquet
LLM_ROUTER_FEEDBACK_PREPROCESSING_CONFIG_URI=gs://llm-router-mlserver/config/v2-20260815/feedback_retraining_preprocessing.json
LLM_ROUTER_TRAINING_CONFIG_URI=gs://llm-router-mlserver/config/v2-20260815/modernbert_t4_balanced_v2.json
LLM_ROUTER_ROUTERARENA_DATASET_URI=gs://llm-router-mlserver/datasets/routerarena/v2-20260815/evaluation.parquet
LLM_ROUTER_EVALUATION_CONFIG_URI=gs://llm-router-mlserver/config/v2-20260815/routerarena_evaluation.json
LLM_ROUTER_PACKAGE_METADATA_URI=gs://llm-router-mlserver/config/v2-20260815/package_metadata.json
# baseline이 아직 없는 첫 학습이라 빈 JSON을 쓴다. G-8 실제 baseline 확정 후
# evaluations/<baseline-version>/metrics.json으로 교체한다.
LLM_ROUTER_BASELINE_METRICS_URI=gs://llm-router-mlserver/config/v2-20260815/baseline_metrics_empty.json
# 운영용 deploy_gate_rules.json은 아직 없다(실제 baseline 성능을 모르면 임계값을
# 못 정한다). smoke 전용 느슨한 gate를 쓰고, G-8 이후 진짜 파일로 교체한다.
LLM_ROUTER_GATE_RULES_URI=gs://llm-router-mlserver/config/v2-20260815/deploy_gate_rules_smoke.json
