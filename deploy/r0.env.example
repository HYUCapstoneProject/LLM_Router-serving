# R0 production profile: preserve and verify any outgoing model group before switching.
LLM_ROUTER_ROUTER_PROFILE=r0
# This example deliberately fails release preflight until real artifacts are supplied.
# Keep the Docker image's pinned BGE defaults; this file changes only router/retraining.
LLM_ROUTER_INTERNAL_API_TOKEN=
LLM_ROUTER_ENABLE_DEVELOPER_API=false
LLM_ROUTER_ROUTER_MODEL_PATH=
LLM_ROUTER_ROUTER_MODEL_PACKAGE_URI=
LLM_ROUTER_ROUTER_MODEL_VERSION=
# Supply LLM_ROUTER_MODEL_CODE_COMMIT as the full real Git SHA at deployment.
LLM_ROUTER_ROUTER_MODEL_CURRENT_POINTER_URI=gs://llm-router-mlserver/releases/r0/models/router-modernbert/CURRENT.json
LLM_ROUTER_ROUTER_MODEL_CACHE_DIR=/app/var/r0/models
LLM_ROUTER_ROUTER_MODEL_REQUIRE_APPROVED=true
LLM_ROUTER_ROUTER_MODEL_AUTO_RELOAD=true
LLM_ROUTER_ROUTER_MODEL_POLL_INTERVAL_SECONDS=60
LLM_ROUTER_ROUTER_MAX_LENGTH=8192
LLM_ROUTER_MODEL_DEVICE=auto
# Explicit PyTorch intra-op threads for the 2-vCPU serving VM.
LLM_ROUTER_MODEL_NUM_THREADS=2
# Container user has no writable home; keep Hugging Face cache on the writable volume.
HF_HOME=/app/var/r0/huggingface

LLM_ROUTER_RETRAINING_DB_PATH=/app/var/r0/retraining.sqlite3
LLM_ROUTER_ALLOWED_GCS_BUCKETS=llm-router-mlserver
LLM_ROUTER_RETRAINING_DERIVED_DATA_ROOT_URI=gs://llm-router-mlserver/releases/r0/datasets/feedback
LLM_ROUTER_RETRAINING_OBSERVABILITY_ROOT_URI=gs://llm-router-mlserver/releases/r0/retraining-runs
LLM_ROUTER_RETRAINING_CONTROL_ROOT_URI=gs://llm-router-mlserver/releases/r0/retraining-control
LLM_ROUTER_RETRAINING_INPUT_CONTRACT=structure-preserving-v2
LLM_ROUTER_RETRAINING_VERSION_POLICY_MODE=successfulHttpRequest
LLM_ROUTER_RETRAINING_INITIAL_LOGICAL_MAJOR=1
LLM_ROUTER_RETRAINING_CALLS_PER_MAJOR=3
LLM_ROUTER_RETRAINING_REBASE_EVERY_MAJOR_CYCLES=5
LLM_ROUTER_RETRAINING_REPLAY_ROWS_PER_LABEL=32
LLM_ROUTER_SUPPORTED_FEEDBACK_SCHEMAS=feedback-inline-v1

LLM_ROUTER_VERTEX_PROJECT=project-763753da-fa8f-4afd-b31
LLM_ROUTER_VERTEX_LOCATION=us-west1
LLM_ROUTER_VERTEX_PIPELINE_TEMPLATE_URI=
LLM_ROUTER_VERTEX_PIPELINE_ROOT=gs://llm-router-mlserver/pipeline-root/r0
LLM_ROUTER_VERTEX_PIPELINE_SERVICE_ACCOUNT=vertex-pipeline-sa@project-763753da-fa8f-4afd-b31.iam.gserviceaccount.com
LLM_ROUTER_VERTEX_TRAINING_SERVICE_ACCOUNT=vertex-training-sa@project-763753da-fa8f-4afd-b31.iam.gserviceaccount.com
LLM_ROUTER_VERTEX_TRAINING_OUTPUT_DIRECTORY=gs://llm-router-mlserver/releases/r0/vertex-training-output
LLM_ROUTER_MODEL_PUBLISH_ROOT_URI=gs://llm-router-mlserver/releases/r0/models/router-modernbert

# Immutable outputs of the ML prepare-r0-release command, plus frozen dataset URIs.
# A successful local profile check does not prove their cloud contents or gate results.
LLM_ROUTER_BASE_TRAINING_DATASET_URI=
LLM_ROUTER_FEEDBACK_PREPROCESSING_CONFIG_URI=
LLM_ROUTER_TRAINING_CONFIG_URI=
LLM_ROUTER_ROUTERARENA_DATASET_URI=
LLM_ROUTER_EVALUATION_CONFIG_URI=
LLM_ROUTER_PACKAGE_METADATA_URI=
LLM_ROUTER_BASELINE_METRICS_URI=
LLM_ROUTER_MODEL_EVALUATION_METRICS_FILENAME=gate_metrics.json
LLM_ROUTER_GATE_RULES_URI=
